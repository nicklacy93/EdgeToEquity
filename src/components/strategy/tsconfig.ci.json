{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "exactOptionalPropertyTypes": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/components/analytics/**/*",
        "src/components/EdgeBot/**/*",
        "src/components/TradeJournal/**/*",
        "src/hooks/useAgentMemory.ts",
        "src/hooks/useChatHistory.ts",
        "src/hooks/useSessionMetadata.ts",
        "src/utils/aiApi.ts",
        "src/utils/chatExportUtils.ts"
    ]
}